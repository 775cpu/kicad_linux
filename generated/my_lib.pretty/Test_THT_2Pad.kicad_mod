(module Test_THT_2Pad (layer F.Cu) (tedit 6A86CFEF)
  (descr "Minimal two-pad through-hole footprint")
  (tags "THT two pad test")
  (fp_line (start -4 -1.5) (end -4 1.5) (layer F.SilkS) (width 0.2))
  (fp_line (start -4 1.5) (end 4 1.5) (layer F.SilkS) (width 0.2))
  (fp_line (start 4 1.5) (end 4 -1.5) (layer F.SilkS) (width 0.2))
  (fp_line (start 4 -1.5) (end -4 -1.5) (layer F.SilkS) (width 0.2))
  (pad 1 thru_hole circle (at -2.54 0) (size 2 2) (drill 1) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 2.54 0) (size 2 2) (drill 1) (layers *.Cu *.Mask))
)