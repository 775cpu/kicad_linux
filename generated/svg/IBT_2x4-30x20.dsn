(pcb "IBT_2x4-30x20"
  (parser (string_quote ") (space_in_quoted_tokens on))
  (resolution um 1)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0 -27250 -13000 8810 -13000 8810 2000 -27250 2000 -27250 -13000))
    (via via0)
    (rule (width 400) (clearance 350))
  )
  (placement
    (component IBT_2x4-30x20
      (place U1 0 0 front 0)
    )
  )
  (library
    (image IBT_2x4-30x20
      (outline (path signal 50 -30000 -20000 30000 -20000 30000 20000 -30000 20000 -30000 -20000))
      (pin PTH_1200_1200 P0 -3810 -8000)
      (pin PTH_1200_1200 P1 -1270 -8000)
      (pin PTH_1200_1200 P2 1270 -8000)
      (pin PTH_1200_1200 P3 3810 -8000)
      (pin PTH_1200_1200 P4 -3810 -5460)
      (pin PTH_1200_1200 P5 -1270 -5460)
      (pin PTH_1200_1200 P6 1270 -5460)
      (pin PTH_1200_1200 P7 3810 -5460)
      (pin PTH_1100_1100 P8 -22250 -3000)
      (pin PTH_1100_1100 P9 -18750 -3000)
      (pin PTH_1100_1100 P10 -15250 -3000)
      (pin PTH_1100_1100 P11 -11750 -3000)
      (pin PTH_1100_1100 P12 -8250 -3000)
      (pin PTH_1100_1100 P13 -4750 -3000)
      (pin PTH_1100_1100 P14 -1250 -3000)
      (pin PTH_1100_1100 P15 2250 -3000)
    )
    (padstack PTH_1200_1200
      (shape (rect F.Cu -600 -600 600 600))
      (shape (rect B.Cu -600 -600 600 600))
      (attach off)
    )
    (padstack PTH_1100_1100
      (shape (rect F.Cu -550 -550 550 550))
      (shape (rect B.Cu -550 -550 550 550))
      (attach off)
    )
    (padstack via0
      (shape (circle F.Cu 500))
      (shape (circle B.Cu 500))
      (attach off)
    )
  )
  (network
    (net NET_1 (pins U1-P0 U1-P8))
    (net NET_2 (pins U1-P1 U1-P9))
    (net NET_3 (pins U1-P2 U1-P10))
    (net NET_4 (pins U1-P3 U1-P11))
    (net NET_5 (pins U1-P4 U1-P12))
    (net NET_6 (pins U1-P5 U1-P13))
    (net NET_7 (pins U1-P6 U1-P14))
    (net NET_8 (pins U1-P7 U1-P15))
    (class default NET_1 NET_2 NET_3 NET_4 NET_5 NET_6 NET_7 NET_8
      (circuit (use_layer F.Cu) (use_via via0))
      (rule (width 400) (clearance 350))
    )
  )
)
